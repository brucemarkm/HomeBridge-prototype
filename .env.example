# All optional. The complete guest demo runs with this file absent.
# Copy to .env.local for local development; enter values securely in Vercel's
# PREVIEW environment for this branch. Do not connect preview to production data.

# Optional authenticated accounts and private workspace sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No Supabase service-role key is used or needed.

# Optional live AI. Also requires Supabase sign-in + the supplied quota migration.
# Guests retain scripted guidance even when live AI is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional licensed RESO/OData feed (not a scraper).
LISTING_LICENSE_CONFIRMED=false
LISTING_PROVIDER_NAME=
LISTING_API_BASE_URL=
LISTING_API_TOKEN=
LISTING_ATTRIBUTION=
# Comma-separated EXACT hostnames for the feed and optional resolver.
LISTING_ALLOWED_HOSTS=
# Comma-separated EXACT hostnames for permitted public listing images.
LISTING_IMAGE_HOSTS=
# At least 32 random characters; signs provider facts sent back to the advisor.
LISTING_DATA_SIGNING_SECRET=

# Optional authorized listing-URL resolution service returning our Home schema.
LISTING_IMPORT_API_URL=
# Required separately when the resolver is on a different host than the feed.
LISTING_IMPORT_API_TOKEN=
